        "packagename": "com.example.hehuoda",
        "minSdkVersion": 23,
        "targetSdkVersion": 34,
        "permissions": [
          "<uses-permission android:name=\"android.permission.INTERNET\"/>"
        ]
      }
    }
  },
  "uniStatistics": { "enable": false }
}
