{
  "name": "禾伙搭",
  "appid": "",
  "description": "禾伙搭普通 uni-app 用户端",
  "versionName": "0.0.0",
  "versionCode": "1",
  "vueVersion": "3",
  "h5": { "router": { "mode": "hash" } },
  "app-plus": {
    "splashscreen": {
      "alwaysShowBeforeRender": true,
      "autoclose": true,
      "androidStyle": "default"
    },
    "distribute": {
      "icons": {
        "android": {
          "ldpi": "static/app-icons/ldpi.png",
          "mdpi": "static/app-icons/mdpi.png",
          "hdpi": "static/app-icons/hdpi.png",
          "xhdpi": "static/app-icons/xhdpi.png",
          "xxhdpi": "static/app-icons/xxhdpi.png",
          "xxxhdpi": "static/app-icons/xxxhdpi.png"
        }
      },
      "android": {
        "packagename": "com.example.hehuoda",
        "minSdkVersion": 23,
        "targetSdkVersion": 34,
        "permissions": [
          "<uses-permission android:name=\"android.permission.INTERNET\"/>"
        ]
      }
    }
  },
  "uniStatistics": { "enable": false }
}
