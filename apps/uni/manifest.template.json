{
  "name": "禾伙搭",
  "appid": "",
  "description": "禾伙搭普通 uni-app 用户端",
  "versionName": "0.0.0",
  "versionCode": "1",
  "vueVersion": "3",
  "h5": { "router": { "mode": "hash" } },
