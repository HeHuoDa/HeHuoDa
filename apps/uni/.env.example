# 留空时仅完成本地编译；实际 AppID 由 #58 准备，填写到本地 .env。
UNI_MP_WEIXIN_APPID=
# 仅正式平台构建使用；要求真实格式 AppID，但不代表账号/域名/审核已验收。
UNI_RELEASE=false

# 编译期公开配置，禁止填写凭据。H5 开发留空走 /api/v1 和本地代理。
# 小程序必须填完整地址；正式环境必须显式配置（完整地址用 HTTPS）。
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=5000
# 仅 H5 development 开发代理使用，不打入客户端。
UNI_DEV_API_TARGET=http://127.0.0.1:3001
