# 留空时仅完成本地编译；实际 AppID 由 #58 准备，填写到本地 .env。
UNI_MP_WEIXIN_APPID=
# 仅正式平台构建使用；要求真实格式 AppID，但不代表账号/域名/审核已验收。
UNI_RELEASE=false

# Android 包名。留空时资源编译使用占位 com.example.hehuoda；
# UNI_RELEASE=true 必须显式注入受控包名，正式归属与命名仍属 #58/#219 后续验收。
# 命名规则：小写反向域名，每段以字母开头，可含数字与下划线，至少两段，禁止 DCloud/Android 保留前缀。
UNI_ANDROID_PACKAGE_NAME=

# 编译期公开配置，禁止填写凭据。H5 开发留空走 /api/v1 和本地代理。
# 小程序必须填完整地址；正式环境必须显式配置（完整地址用 HTTPS）。
# Android（dev:app/build:app）任何 mode 都必须是完整 HTTPS 地址，
# 不接受相对/协议相对/明文/凭据/查询/片段/非默认端口/IP 字面量/单标签主机。
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=5000
# 仅 H5 development 开发代理使用，不打入客户端。
UNI_DEV_API_TARGET=http://127.0.0.1:3001
