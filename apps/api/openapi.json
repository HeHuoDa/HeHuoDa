    "/api/v1/competitions": {
      "get": {
        "operationId": "CompetitionController_list",
        "parameters": [
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "description": "单值1–50，缺省20",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "单值正安全整数；超过页数返回最后有效页",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "upcoming",
                "open",
                "closed",
                "unknown",
                "conflict"
              ],
              "type": "string"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "单值，字面包含，最长100字符",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hosts",
            "required": false,
            "in": "query",
            "description": "缺省/all 不限；空值无结果；支持重复与逗号合并，合法自选优先",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionListDto"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "tags": [
          "比赛"
        ]
      }
    },
    "/api/v1/competitions/{id}": {
      "get": {
        "operationId": "CompetitionController_detail",
