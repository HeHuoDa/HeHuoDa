  "components": {
    "schemas": {
      "ReadinessResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "unavailable"
            ]
          },
          "requestId": {
            "type": "string",
            "description": "当前请求关联 ID"
          }
        },
        "required": [
          "status",
          "requestId"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok",
            "enum": [
              "ok"
            ]
          },
          "requestId": {
            "type": "string",
            "description": "Fastify 为当前请求生成的关联 ID。",
            "example": "req-1"
          }
        },
        "required": [
          "status",
          "requestId"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "INTERNAL_SERVER_ERROR"
          },
          "message": {
            "type": "string",
            "example": "服务器内部错误"
          },
          "requestId": {
            "type": "string",
            "example": "req-1"
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "description": "可选的公开错误详情。"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "CollegeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "order": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "order"
        ]
      },
      "CompetitionSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "edition": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "organizer": {
            "type": "string"
          },
          "origin": {
            "type": "string",
            "enum": [
              "official",
              "historical",
              "demo"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "edition",
          "category",
          "organizer",
          "origin"
        ]
      },
      "ScopeDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "all",
              "colleges",
              "complex",
              "unknown"
            ]
          },
          "colleges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "colleges",
          "note"
        ]
      },
      "TimeDto": {
        "type": "object",
        "properties": {
          "precision": {
            "type": "string",
            "enum": [
              "instant",
              "date",
              "unknown"
            ]
          },
          "value": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "precision",
          "value"
        ]
      },
      "StageSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "hosts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "$ref": "#/components/schemas/ScopeDto"
          },
          "deadline": {
            "$ref": "#/components/schemas/TimeDto"
          },
          "materialsAt": {
            "$ref": "#/components/schemas/TimeDto"
          },
          "conflict": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "upcoming",
              "open",
              "closed",
              "unknown",
              "conflict"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "hosts",
          "scope",
          "deadline",
          "materialsAt",
          "conflict",
          "status"
        ]
      },
      "EntryDto": {
        "type": "object",
        "properties": {
          "competition": {
            "$ref": "#/components/schemas/CompetitionSummaryDto"
          },
          "stage": {
            "$ref": "#/components/schemas/StageSummaryDto"
          }
        },
        "required": [
          "competition",
          "stage"
        ]
      },
      "CompetitionListDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntryDto"
            }
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "hasMore": {
            "type": "boolean"
          },
          "totalStages": {
            "type": "number"
          },
          "totalCompetitions": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          },
          "evaluatedAt": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "hasMore",
          "totalStages",
          "totalCompetitions",
          "totalPages",
          "evaluatedAt"
        ]
      },
      "TrackDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "individual",
              "team",
              "mixed"
            ]
          },
          "members": {
            "type": "string"
          },
          "rules": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "mode",
          "members",
          "rules"
        ]
      },
      "StageDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "organizer": {
            "type": "string"
          },
          "hosts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "$ref": "#/components/schemas/ScopeDto"
          },
          "startsAt": {
            "$ref": "#/components/schemas/TimeDto"
          },
          "deadline": {
            "$ref": "#/components/schemas/TimeDto"
          },
          "materialsAt": {
            "$ref": "#/components/schemas/TimeDto"
          },
          "eventAt": {
            "$ref": "#/components/schemas/TimeDto"
          },
          "timeNote": {
            "type": "string"
          },
          "conflict": {
            "type": "boolean"
          },
          "registration": {
            "type": "string"
          },
          "order": {
            "type": "number"
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "upcoming",
              "open",
              "closed",
              "unknown",
              "conflict"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "organizer",
          "hosts",
          "scope",
          "startsAt",
          "deadline",
          "materialsAt",
          "eventAt",
          "timeNote",
          "conflict",
          "registration",
          "order",
          "sourceIds",
          "status"
        ]
      },
      "NoticeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string",
            "nullable": true
          },
          "checkedAt": {
            "type": "string",
            "nullable": true
          },
          "kind": {
            "type": "string",
            "enum": [
              "registration",
              "supplement",
              "award",
              "news"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "publishedAt",
          "checkedAt",
          "kind"
        ]
      },
      "CompetitionDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "edition": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "organizer": {
            "type": "string"
          },
          "origin": {
            "type": "string",
            "enum": [
              "official",
              "historical",
              "demo"
            ]
          },
          "tracks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrackDto"
            }
          },
          "stages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StageDto"
            }
          },
          "notices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NoticeDto"
            }
          },
          "evaluatedAt": {
