          "id",
          "name",
          "edition",
          "category",
          "organizer",
          "origin",
          "tracks",
          "stages",
          "notices",
          "evaluatedAt"
        ]
      },
      "WechatLoginRequestDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "uni.login 取得的微信临时授权码",
            "maxLength": 512
          },
          "consentVersion": {
            "type": "number",
            "description": "用户已确认的平台协议版本；当前为 1",
            "minimum": 1,
            "example": 1
          }
        },
        "required": [
          "code",
          "consentVersion"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nickname": {
            "type": "string",
            "example": "微信用户"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "restricted",
              "closing",
              "deleted"
            ]
          }
        },
        "required": [
          "id",
          "nickname",
          "status"
        ]
      },
      "CredentialResponseDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "active"
            ],
            "description": "凭据生命周期类别"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          },
          "accessToken": {
            "type": "string",
            "description": "访问凭据，15 分钟有效"
          },
          "refreshToken": {
            "type": "string",
            "description": "刷新凭据，随会话绝对期限失效"
          },
          "accessExpiresAt": {
            "type": "string",
            "example": "2026-10-24T12:15:00.000Z"
          },
          "sessionExpiresAt": {
            "type": "string",
            "example": "2026-11-23T12:00:00.000Z",
            "description": "会话绝对期限，刷新不会延长"
          }
        },
        "required": [
          "kind",
          "user",
          "accessToken",
          "refreshToken",
          "accessExpiresAt",
          "sessionExpiresAt"
        ]
      },
      "RefreshRequestDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "刷新凭据",
            "maxLength": 512
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "CampusStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "unverified"
            ],
            "description": "校园核验状态；核验模块接入前恒为 unverified"
          },
          "termId": {
            "type": "string",
            "nullable": true
          },
          "verifiedAt": {
            "type": "string",
            "nullable": true
          },
          "validUntil": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "status"
        ]
      },
      "AvailabilityDto": {
        "type": "object",
        "properties": {
          "teaming": {
            "type": "boolean",
            "example": false,
            "description": "组队业务是否对该账号开放；false 表示尚未开放"
          }
        },
        "required": [
          "teaming"
        ]
      },
      "ProfileResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDto"
          },
          "campus": {
            "$ref": "#/components/schemas/CampusStatusDto"
          },
          "availability": {
            "$ref": "#/components/schemas/AvailabilityDto"
          }
        },
        "required": [
          "user",
          "campus",
          "availability"
        ]
      },
      "UpdateProfileRequestDto": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
            "description": "新昵称，trim 后 1–20 字",
            "minLength": 1,
            "maxLength": 20
          }
        },
        "required": [
          "nickname"
        ]
      }
    }
  }
}
