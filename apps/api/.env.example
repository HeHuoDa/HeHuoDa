NODE_ENV=development
PORT=3001
HOST=127.0.0.1
# 管理员登录默认因空白允许来源而关闭；填写管理页面完整 Origin，生产仅 HTTPS。
ADMIN_ALLOWED_ORIGINS=
ADMIN_SESSION_HOURS=12
ADMIN_RATE_LOGIN_SOURCE=30
ADMIN_RATE_LOGIN_ACCOUNT=5
ADMIN_RATE_LOGIN_GLOBAL=100
# 直接启动留空；隔离反向代理部署显式填写最近一跳可信代理网段。
API_TRUSTED_PROXY_CIDRS=
# 生产环境默认不注册文档路由；仅在受控网络显式开启。
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://hehuoda:hehuoda_local@127.0.0.1:54322/hehuoda
# 默认每天北京时间 09:00、18:00 扫描；设 false 关闭；测试/OpenAPI 不采集。
INGESTION_ENABLED=true
INGESTION_RAW_DAYS=30
# 当前缺少正式校园/组队/治理提供者；设 true 将拒绝启动。
SENSITIVE_BUSINESS_ENABLED=false
# 校园核验默认关闭；学期由运营配置，禁止猜固定月份。
CAMPUS_VERIFICATION_ENABLED=false
CAMPUS_POLICY_VERSION=2
# 2026 秋季学期：北京时间 9月7日 至 1月18日（含），endAt 为排他边界。
CAMPUS_TERMS=[{"id":"2026-2027-1","startAt":"2026-09-07T00:00:00+08:00","endAt":"2027-01-19T00:00:00+08:00"}]
# 独立随机32字节密钥的标准 base64；变更须专项迁移。
CAMPUS_SUBJECT_HMAC_KEY=
# JSON 对象 {keyId:base64Key}；保留需解密旧资料/备份的旧键。
CAMPUS_PROFILE_KEYS={}
CAMPUS_PROFILE_KEY_ID=
CAMPUS_RATE_SUBMIT_USER=5
CAMPUS_RATE_SUBMIT_SOURCE=100
CAMPUS_RATE_SUBMIT_GLOBAL=500
CAMPUS_RATE_CHALLENGE_USER=5
CAMPUS_RATE_CHALLENGE_SOURCE=100
CAMPUS_RATE_CHALLENGE_GLOBAL=500
# 仅在系统 DNS 返回 fake-IP 时，按可信 DNS 当前答案填写白名单来源的公网地址；禁止填私网。
# INGESTION_DNS_OVERRIDES={"xxgc.sicau.edu.cn":["经核实的公网IP"],"smkx.sicau.edu.cn":["经核实的公网IP"]}
