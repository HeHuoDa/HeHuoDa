NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://hehuoren:hehuoren_local@127.0.0.1:54322/hehuoren
# 显式开启后每天北京时间 09:00、18:00 扫描；测试/OpenAPI 不采集。
INGESTION_ENABLED=false
INGESTION_RAW_DAYS=30
# 仅在系统 DNS 返回 fake-IP 时，按可信 DNS 当前答案填写白名单来源的公网地址；禁止填私网。
