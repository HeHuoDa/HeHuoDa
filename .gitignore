# Local Git worktrees are disposable development checkouts.
.worktrees/

# Machine-specific agent settings and credentials
.codex/
.claude/settings.local.json
.secrets/
.aws/

# Dependencies and build output
node_modules/
.pnpm-store/
*.tsbuildinfo
dist/
dist-ssr/
dist-openapi/
coverage/
.nyc_output/
.turbo/
.vite/
.cache/
.eslintcache
.stylelintcache

# Local environment files (keep the documented template)
.env
.env.*
!.env.example
!.env.*.example

# Local logs, temporary files, and runtime data
logs/
*.log
*.tmp
*.temp
/tmp/
/temp/
.data/
apps/api/uploads/
apps/api/storage/
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Browser test output
.auth/
.playwright-mcp/
playwright-report/
blob-report/
test-results/

# Personal editor settings (keep shared project configuration)
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/*.code-snippets
*.swp
*.swo
*~

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Local development references and acceptance artifacts
/docs/screenshots/
/docs/demos/
/docs/research/
/docs/superpowers/
/docs/issue-*-validation.md
/docs/issue-*-*-results.json
/docs/issue-*-browser-check.*
/docs/issue-*-build-*.json

# uni-app generated configuration (keep templates and public source config)
/apps/uni/src/manifest.json
/apps/uni/**/project.private.config.json

# uni-app/HBuilderX output, local tools, caches and development artifacts.
# dist/, node_modules/, .vite/, .cache/, coverage/ and test-results/ are
# already ignored above at every depth. Keep src/, static/, uni_modules/,
# nativeplugins/, maintained scripts/tests and license notices tracked.
/apps/uni/**/unpackage/
/apps/uni/**/.hbuilderx/
/apps/uni/**/.uni/
/apps/uni/**/.uniapp/
/apps/uni/**/.dcloud/
/apps/uni/**/.local/
/apps/uni/**/.scratch/
/apps/uni/**/.artifacts/
/apps/uni/**/.temp/
/apps/uni/**/.tmp/
/apps/uni/tmp/
/apps/uni/temp/
/apps/uni/artifacts/
/apps/uni/reports/
/apps/uni/screenshots/
/apps/uni/recordings/
/apps/uni/traces/
/apps/uni/downloads/
/apps/uni/vite.config.*.timestamp-*

# Optional local image/font tooling environments and bytecode
/apps/uni/**/__pycache__/
/apps/uni/**/*.py[cod]
/apps/uni/**/.venv/
/apps/uni/venv/
/apps/uni/**/.pytest_cache/
/apps/uni/**/.mypy_cache/
/apps/uni/**/.ruff_cache/

# Packaged application/upload output and patch/editor leftovers
/apps/uni/**/*.wxapkg
/apps/uni/**/*.wgt
/apps/uni/**/*.wgtu
/apps/uni/**/*.apk
/apps/uni/**/*.aab
/apps/uni/**/*.ipa
/apps/uni/**/*.bak
/apps/uni/**/*.orig
/apps/uni/**/*.rej
