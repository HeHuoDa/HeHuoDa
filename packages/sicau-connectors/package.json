{
  "name": "@hehuoda/sicau-connectors",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./notices": {
      "types": "./dist/notices/index.d.ts",
      "import": "./dist/notices/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm build && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test:unit": "pnpm build && node --test test/entry.test.mjs && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config test/jest.json --runInBand"
  },
  "dependencies": {
    "cheerio": "1.2.0"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@types/jest": "30.0.0",
    "@types/node": "^24.0.0",
    "jest": "30.5.2",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3"
  }
}
