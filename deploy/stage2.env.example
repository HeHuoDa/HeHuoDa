# Issue #206 阶段二：隔离测试环境配置模板。
#
# 复制到受控目录（如 /opt/hehuoda-test/.env，权限 600）后填写，不要提交真实值。
# 与生产 .env 的区别是刻意且必须保持的：
#   - 独立 COMPOSE 项目名、独立数据库名与密码（不得复用生产密码）
#   - 入口只绑定回环地址，数据库不发布端口
#   - 官网自动调度、微信登录、校园核验一律关闭
#   - 不使用生产管理员账号、Cookie、身份密钥
#
# 校验：node deploy/stage2.mjs check-env /opt/hehuoda-test/.env

# 测试栈的 Compose 项目名；生产为 hehuoda-deploy，二者必须不同。
COMPOSE_PROJECT_NAME=hehuoda-stage2
# 复用同一 SHA 已通过 CI 的本地镜像标签，不在服务器重建。
IMAGE_PREFIX=hehuoda-local
IMAGE_TAG=
# 测试库独立命名，避免与生产 hehuoda 混淆。
POSTGRES_USER=stage2
POSTGRES_DB=hehuoda_stage2_test
POSTGRES_PASSWORD=
# URL 编码后的密码，须与 POSTGRES_* 一致并指向 db:5432。
DATABASE_URL=
# 仅回环绑定；开发机通过 SSH 隧道访问 http://127.0.0.1:18080。
HTTP_BIND=127.0.0.1
HTTP_PORT=18080
# 自动调度关闭：本阶段不做长期后台采集，容量样本由受控步骤写入。
INGESTION_ENABLED=false
INGESTION_RAW_DAYS=30
# 附件下载默认关闭；容量测量时以显式步骤驱动。
# 注意：只有 compose.deploy.yaml 显式引用的变量才会注入 API 容器。
# INGESTION_ATTACHMENTS_ENABLED 与 SENSITIVE_BUSINESS_ENABLED 当前不在该清单内，
# 容器内取不到它们（按未定义处理，即关闭）。保留在这里只为记录意图；
# 要真正开启，须先在 compose.deploy.yaml 的 api.environment 中显式引用。
# （本阶段两者都不开启，因此不影响隔离结果。）
INGESTION_ATTACHMENTS_ENABLED=false
SENSITIVE_BUSINESS_ENABLED=false
# 管理端无独立线上镜像；需要管理接口时由开发机经隧道直连测试 API。
ADMIN_ALLOWED_ORIGINS=
ADMIN_SESSION_HOURS=12
ADMIN_RATE_LOGIN_ACCOUNT=5
ADMIN_RATE_LOGIN_SOURCE=30
ADMIN_RATE_LOGIN_GLOBAL=100
# 微信登录与校园核验在测试环境一律关闭，不使用生产身份密钥。
WECHAT_LOGIN_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
CAMPUS_VERIFICATION_ENABLED=false
CAMPUS_POLICY_VERSION=2
CAMPUS_TERMS=[]
CAMPUS_SUBJECT_HMAC_KEY=
CAMPUS_PROFILE_KEYS={}
CAMPUS_PROFILE_KEY_ID=
