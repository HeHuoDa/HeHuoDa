# Copy to a protected deployment directory as .env; never commit real values.
COMPOSE_PROJECT_NAME=hehuoda-deploy
IMAGE_PREFIX=ghcr.io/hehuoda/hehuoda
# Exact checked commit SHA (40 lowercase hex characters).
IMAGE_TAG=
POSTGRES_USER=hehuoda
POSTGRES_DB=hehuoda
POSTGRES_PASSWORD=
# URL-encode the password; this must match POSTGRES_* and use db:5432.
DATABASE_URL=
# Loopback by default. Set 0.0.0.0 only for an intentional IP test deployment.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
INGESTION_ENABLED=false
INGESTION_RAW_DAYS=30
SENSITIVE_BUSINESS_ENABLED=false
# 每个同宿主部署选一个不重叠的 /24 网段前三段；Nginx 固定 .3，API 动态分配。
# 已有部署改网络须受控维护，不直接切换运行中的数据库网络。
PROXY_ADDRESS_PREFIX=172.30.135
