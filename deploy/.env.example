# Copy to a protected deployment directory as .env; never commit real values.
COMPOSE_PROJECT_NAME=hehuoda-deploy
IMAGE_PREFIX=ghcr.io/hehuoda/hehuoda
# Exact checked commit SHA (40 lowercase hex characters).
IMAGE_TAG=
POSTGRES_USER=hehuoda
POSTGRES_DB=hehuoda
POSTGRES_PASSWORD=
# URL-encode the password; this must match POSTGRES_* and use db:5432.
DATABASE_URL=
# Loopback by default. Set 0.0.0.0 only for an intentional IP test deployment.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
INGESTION_ENABLED=false
INGESTION_RAW_DAYS=30
SENSITIVE_BUSINESS_ENABLED=false
# 管理Origin默认留空关闭登录；正式管理页面仅允许精确HTTPS Origin。
ADMIN_ALLOWED_ORIGINS=
ADMIN_SESSION_HOURS=12
ADMIN_RATE_LOGIN_ACCOUNT=5
ADMIN_RATE_LOGIN_SOURCE=30
ADMIN_RATE_LOGIN_GLOBAL=100
# 微信登录与校园核验独立开放；正式环境只使用真实微信接口。
WECHAT_LOGIN_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
CAMPUS_VERIFICATION_ENABLED=false
CAMPUS_POLICY_VERSION=2
# 北京时间 2026-09-07 至 2027-01-18（含）；结束边界为次日零点。
CAMPUS_TERMS=[{"id":"2026-2027-1","startAt":"2026-09-07T00:00:00+08:00","endAt":"2027-01-19T00:00:00+08:00"}]
# 两类密钥分别生成32字节标准base64；不得替换已有绑定/资料所需密钥。
CAMPUS_SUBJECT_HMAC_KEY=
CAMPUS_PROFILE_KEYS={}
CAMPUS_PROFILE_KEY_ID=
